rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Funzione per verificare il ruolo dell'utente
    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Funzione per verificare che lo studente sia associato al genitore
    function isStudentLinkedToParent(studentId) {
      return studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudents;
    }

    // Regole per la collezione users
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isRole('admin'));
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isRole('admin'));
      allow delete: if request.auth != null && isRole('admin');
    }

    // Regole per la collezione students
    match /students/{studentId} {
      allow read: if request.auth != null && (
        isStudentLinkedToParent(studentId) ||
        isRole('operatore') ||
        isRole('admin')
      );
      allow create: if request.auth != null && isRole('admin');
      allow update: if request.auth != null && isRole('admin');
      allow delete: if request.auth != null && isRole('admin');
    }

    // Regole per la collezione transactions
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudents ||
        isRole('operatore') ||
        isRole('admin')
      );
      allow create: if request.auth != null && (
        isRole('operatore') ||
        isRole('admin') ||
        (isRole('genitore') && request.resource.data.type == 'ricarica' &&
          request.resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudents)
      );
      allow update: if request.auth != null && isRole('admin');
      allow delete: if request.auth != null && isRole('admin');
    }

    // Regole per la collezione schools (se implementata)
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isRole('admin');
    }
  }
}